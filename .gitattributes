# Generated files: rebuilt by tools, reviewed by their source.
src/wm_doc/explorer/app/** linguist-generated=true -diff
explorer-ui/src/contract/explorer-v1.ts linguist-generated=true
docs/contracts/*.schema.json linguist-generated=true
explorer-ui/package-lock.json linguist-generated=true -diff
explorer-ui/src/domain/graph-fixture.json linguist-generated=true

# Fixture files are checked against tests/fixtures/checksums.sha256, so their bytes must not
# change on checkout: text files keep LF line endings everywhere, binary files are left alone.
samples/** text=auto eol=lf

# Golden test snapshots are compared byte for byte.
tests/fixtures/golden/** text eol=lf

# The explorer app is formatted with LF (Prettier) and its committed build must not depend on
# the checkout: with CRLF sources Vite writes mixed line endings into index.html.
explorer-ui/** text=auto eol=lf
src/wm_doc/explorer/app/** text=auto eol=lf
